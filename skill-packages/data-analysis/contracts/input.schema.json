{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "dataset": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "DatasetRef",
            "TransformerRef",
            "ReportRef",
            "SplitMapRef"
          ]
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "project_id",
        "artifact_id",
        "digest"
      ],
      "additionalProperties": false
    },
    "workflow_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "fit_scope": {
      "type": "string",
      "enum": [
        "train",
        "undefined"
      ]
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    }
  },
  "required": [
    "project_id",
    "dataset",
    "workflow_revision",
    "goal",
    "fit_scope",
    "policy_version"
  ],
  "additionalProperties": false
}
