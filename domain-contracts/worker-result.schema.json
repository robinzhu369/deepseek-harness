{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "RawFileRef",
              "DatasetRef",
              "TransformerRef",
              "ReportRef",
              "SplitMapRef",
              "ExportRef"
            ]
          },
          "object_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "kind",
          "object_key",
          "digest",
          "bytes",
          "metadata"
        ],
        "additionalProperties": false
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "removed_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "removed_fraction"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "outputs",
    "impact"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
